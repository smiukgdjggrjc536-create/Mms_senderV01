# ========================================================================
# MMS Sender V7 — Environment Variables
# ========================================================================
# Copy this file to .env.local for local development.
# Vercel:  Project Settings -> Environment Variables
# Netlify: Site Settings   -> Environment Variables
# ========================================================================

# ---- Database ----
# MongoDB connection string. NEVER hardcode in source (V7 P1.1).
# The vault (.credentials.enc) also stores a copy; server code prefers env.
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/?appName=MmsDB
MONGODB_DB=test

# ---- Auth / JWT ----
# JWT secret (HS256). Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=your_random_64_character_secret_here

# ---- Credentials Vault (V7 P1.1) ----
# Master key for AES-256-GCM vault. 48-byte random.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# If unset, vault.js falls back to an INSECURE dev passphrase (dev only).
CRED_MASTER_KEY=

# Optional: override vault file path (default: .credentials.enc in project root)
# CRED_VAULT_PATH=

# ---- Redis ----
# If unset, the gateway falls back to an in-memory shim (single-process only).
REDIS_URL=
REDIS_KEY_PREFIX=mms_gw:

# ---- Public site URL ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Panel mode (admin | user) ----
# Same codebase, 2 deployments: Vercel=user, Netlify=admin.
NEXT_PUBLIC_PANEL_MODE=user

# ---- Admin seed (optional, used by seed_credentials.cjs only if doc absent) ----
# ADMIN_SEED_PASSWORD=
# TESTUSER_SEED_PASSWORD=
